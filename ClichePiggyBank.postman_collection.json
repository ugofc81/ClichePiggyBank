    {
      "name": "account reset",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const cookieJar = pm.cookies.jar();\r",
              "\r",
              "// Define the mandatory cookie string with the .google.com domain\r",
              "const consentCookie = \"CONSENT=PENDING+999; Domain=.google.com; Path=/; Secure; SameSite=None\";\r",
              "\r",
              "cookieJar.set(\"https://google.com\", \"CONSENT\", consentCookie, function (error) {\r",
              "    if (error) {\r",
              "        console.error(\"Injection failed! Double-check your Cookie Allowlist:\", error);\r",
              "    } else {\r",
              "        console.log(\"Cookie successfully set!\");\r",
              "    }\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
